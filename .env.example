# API
DATABASE_URL=sqlite:///./jobagent.db
API_HOST=127.0.0.1
API_PORT=8000
# REQUIRED: replace this before any non-local use
WORKER_API_KEY=change-me-local-worker-key
STORAGE_PATH=./storage
CORS_ORIGINS=http://localhost:3000

# Optional, per-request opt-in resume enhancement
# The local deterministic pipeline remains the default and fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Worker (local machine only — never commit storage_state.json)
API_BASE_URL=http://localhost:8000
WORKER_API_KEY=change-me-local-worker-key
LINKEDIN_STORAGE_STATE=./worker/scraper/storage_state.json
SCRAPE_INTERVAL_HOURS=6
